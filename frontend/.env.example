# Azure AD (Entra ID) SPA app registration client id
VITE_AAD_CLIENT_ID=<your-spa-app-client-id>

# Your Entra tenant id
VITE_AAD_TENANT_ID=<your-tenant-id>

# The scope exposed by the backend API app registration
# e.g. api://<your-api-app-client-id>/access_as_user
VITE_API_SCOPE=api://<your-api-app-client-id>/access_as_user

# Base URL of the backend API
VITE_API_BASE_URL=https://localhost:7xxx
